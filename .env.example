# Supabase project settings — find these in your Supabase project at
# Project Settings > API (URL and "anon public" key).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# GLM (Zhipu/Z.ai) API key for the "Analyze with AI" literature feature.
# Deliberately WITHOUT a VITE_ prefix — Vite only inlines VITE_-prefixed vars
# into the client bundle, so this stays server-side, read only by the Netlify
# function at netlify/functions/analyze-literature.js. Set it in the Netlify
# dashboard (Site settings > Environment variables), not just here — this
# file is for local `netlify dev` only.
GLM_API_KEY=your-glm-api-key
